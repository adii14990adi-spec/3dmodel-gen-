{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forge3D Job Specification",
  "type": "object",
  "required": ["schema_version", "job_id", "job_type", "input_refs", "output_dir", "timeout_sec"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "job_type": {
      "type": "string",
      "enum": ["health_check", "analyze", "assemble"]
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    },
    "timeout_sec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    }
  }
}
